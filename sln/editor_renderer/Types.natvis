<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="Array&lt;*&gt;">
		<DisplayString>{{ Size = {m_size}, Capacity={m_capacity} }}</DisplayString>
		<Expand>
			<Item Name="[size]" ExcludeView="simple">m_size</Item>
			<Item Name="[capacity]" ExcludeView="simple">m_capacity</Item>
			<ArrayItems>
				<Size>m_size</Size>
				<ValuePointer>m_data</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="TruthMap::InlineArray">
		<DisplayString>{{ Size = {size} }}</DisplayString>
		<Expand>
			<Item Name="[size]" ExcludeView="simple">size</Item>
			<ArrayItems>
				<Size>size</Size>
				<ValuePointer>data</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="DynamicData">
		<DisplayString Condition="type == Type_Null">"test"</DisplayString>
		<DisplayString Condition="type == Type_Object">Object</DisplayString>
		<DisplayString Condition="type == Type_Set">Set</DisplayString>
		<DisplayString Condition="type == Type_Integer">Integer: {integer}</DisplayString>
		<DisplayString Condition="type == Type_Number">Number: {number}</DisplayString>
		<DisplayString Condition="type == Type_String">String: {string,s}</DisplayString>

		<Expand>
			<Item Name="type">type</Item>
			<Item Name="value" Condition="type == Type_Null">"test"</Item>
			<Item Name="Object" Condition="type == Type_Object">DynamicData_DebugExpression(hObject) </Item>
			<Item Name="value" Condition="type == Type_Set">integer</Item>
			<Item Name="value" Condition="type == Type_Integer">integer</Item>
			<Item Name="value" Condition="type == Type_Number">number</Item>
			<Item Name="value" Condition="type == Type_String">string,s</Item>
		</Expand>
	</Type>
</AutoVisualizer>